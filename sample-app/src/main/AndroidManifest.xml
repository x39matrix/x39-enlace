<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="io.livekit.android.sample">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Recepción en segundo plano: la línea la sostiene el ServicioX39, sin Google. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 15 corta los servicios "dataSync" a las 6 h al día. Una línea de llamadas
         tiene que estar siempre, así que en Android 14+ el tipo es "specialUse". El permiso
         FOREGROUND_SERVICE_DATA_SYNC (solo existe desde Android 14) no hace falta: en 14+ el
         servicio nunca arranca como dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Fuera lo que arrastran el ejemplo de LiveKit (sample-app-common) y el SDK y x39 no usa:
         compartir pantalla y el servicio de "reproducción" del ejemplo. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Vigilante de Doze cada 10 min y salida de la lista de ahorro de batería. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
<application
        android:name=".SampleApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/x39_edicion_nombre"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Pantalla «En llamada» de x39 (voz y vídeo). -->
        <activity
            android:name=".X39EnLlamadaActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".EscanerQr" android:exported="false" />
        <!-- Visor de fotos: se ven DENTRO de x39, sin pasar por otras apps. -->
        <activity
            android:name=".X39VisorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- La sala privada de un contacto. Se abre con su huella. -->
        <activity
            android:name=".X39ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!--
          Llamada entrante a pantalla completa. showOnLockScreen + turnScreenOn para que
          salga con el móvil bloqueado; singleInstance para que no se mezcle con la app.
        -->
        <activity
            android:name=".X39EntranteActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
          ServicioX39: el dueño de la línea. Sostiene el socket como specialUse (Android 14+)
          o dataSync (Android 10-13, donde specialUse no existe y el tipo pasado a
          startForeground tiene que estar declarado aquí); durante la llamada añade
          microphone y camera (se cambia en caliente con startForeground).
        -->
        <service
            android:name=".ServicioX39"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse|dataSync|microphone|camera">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantiene abierta la conexión de señalización de x39 para poder recibir llamadas y videollamadas cifradas de extremo a extremo sin depender de un servicio de notificaciones push de terceros." />
        </service>

        <!-- El receptor VolcadoVerificacion (volcado de vídeos por adb) vive en src/debug:
             no existe en el APK de publicación. -->

        <!-- Al encender el móvil se levanta la línea sin abrir la app. -->
        <receiver
            android:name=".ArranqueReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".X39CallActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- x39tunel: el servicio VPN de la biblioteca de WireGuard (su manifiesto antiguo no declara exported) -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:node="merge" />

        <!-- Servicios que x39 no usa: el de "reproducción" del ejemplo de LiveKit (solo lo arranca
             CallViewModel, de sample-app-common, que x39 no usa) y el de compartir pantalla del SDK. -->
        <service
            android:name="io.livekit.android.sample.service.ForegroundService"
            tools:node="remove" />
        <service
            android:name="io.livekit.android.room.track.screencapture.ScreenCaptureService"
            tools:node="remove" />
        <!-- Idioma elegido en Ajustes: en Android 7-12 lo guarda AppCompat (en 13+ lo guarda el sistema). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
